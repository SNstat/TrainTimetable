{
  "compilerOptions": {
    "target": "es2016",
    "module": "ES6",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "wwwroot/Scripts/JsOut",
    "rootDir": "wwwroot/Scripts/TsRoot"
  },
  "include": [
    "wwwroot/Scripts/TsRoot/**/*.ts"
  ]
}