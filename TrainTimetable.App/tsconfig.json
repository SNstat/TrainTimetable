{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "wwwroot/scripts/out",
    "rootDir": "wwwroot/scripts/src"
  },
  "include": [
    "wwwroot/scripts/src/**/*.ts"
  ]
}