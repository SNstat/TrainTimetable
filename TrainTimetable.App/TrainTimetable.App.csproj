<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.TypeScript.MSBuild">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="MudBlazor" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrainTimetable.App.Identity\TrainTimetable.App.Identity.csproj" />
    <ProjectReference Include="..\TrainTimetable.App.Shared\TrainTimetable.App.Shared.csproj" />
    <ProjectReference Include="..\TrainTimetable.Business\TrainTimetable.Business.csproj" />
  </ItemGroup>

  <ItemGroup>
	<Content Remove="wwwroot\scripts\out\**" />
	<None Include="wwwroot\scripts\out\**">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\scripts\src\cookies.ts" />
  </ItemGroup>

  <ItemGroup>
    <TypeScriptCompile Include="wwwroot\scripts\src\cookies.ts" />
  </ItemGroup>

</Project>
