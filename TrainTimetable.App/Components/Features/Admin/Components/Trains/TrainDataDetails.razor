@using System.ComponentModel.DataAnnotations

@page "/admin/trains/{id:int:range(0, 2147483647)}"

@inject ITrainService TrainService
@inject ITrainManufacturerService TrainManufacturerService
@inject NavigationManager NavigationManager

<PageTitle>Train Details</PageTitle>

<MudStack Row="true">
    <MudAvatar Class="ml-2" @onclick="GoBack" Color="Color.Primary" Variant="Variant.Outlined" style="cursor: pointer">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack">
        </MudIcon>
    </MudAvatar>

    <MudText Typo="Typo.h6" Class="mt-1 mb-5">
        @TitleText
    </MudText>
</MudStack>

@if (Model == null)
{
    <MudStack Class="px-8 my-8" Row="true">
        <MudIcon Color="Color.Error" Icon="@Icons.Material.Filled.Error" Class="mt-1"></MudIcon>
        <MudText Typo="Typo.h6" Color="Color.Error">There is no train with ID: <b>@Id </b></MudText>
    </MudStack>
} else
{
    <EditForm T="Train" EditContext="editContext" OnValidSubmit="ValidSubmit">
        <DataAnnotationsValidator />
        <MudCard style="background-color: var(--mud-palette-drawer-background);">
            <MudCardContent>
                <MudGrid>
                    <MudItem md="6" sm="12">
                        <MudNumericField Class="mt-3"
                                         Style="background-color: var(--mud-palette-surface);"
                                         Label="Train Number"
                                         Variant="Variant.Outlined"
                                         Value="Model!.TrainNumber"
                                         ValueChanged="@(async (int _) => await TrainNumberChanged(_))"
                                         For="@(() => Model!.TrainNumber)"
                                         Min="1" Max="1000000" />
                    </MudItem>
                    <MudItem md="6" sm="12">
                        <MudTextField Label="Train Name"
                                      Style="background-color: var(--mud-palette-surface);"
                                      Class="mt-3"
                                      Variant="Variant.Outlined"
                                      Value="Model?.Name"
                                      ValueChanged="@(async (string _) => await TrainNameChanged(_))"
                                      For="@(() => Model!.Name)" />
                    </MudItem>
                    <MudItem md="4" sm="12">
                        <MudNumericField T="int"
                                         Class="mt-3"
                                         Label="Seats"
                                         Value="Model!.SeatCount"
                                         ValueChanged="SeatCountChange"
                                         For="@(() => Model!.SeatCount)"
                                         Min="1" Max="1000"
                                         Style="background-color: var(--mud-palette-surface);"
                                         Adornment="Adornment.Start"
                                         Variant="Variant.Outlined"
                                         AdornmentIcon="@Icons.Material.Filled.EventSeat" />
                    </MudItem>
                    <MudItem md="4" sm="12">
                        <MudNumericField Class="mt-3"
                                         Label="Disabled Seats"
                                         Style="background-color: var(--mud-palette-surface);"
                                         @bind-Value="Model!.DisabledSeatCount"
                                         For="@(() => Model!.DisabledSeatCount)"
                                         Min="0" Max="Model!.SeatCount"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.WheelchairPickup" />
                    </MudItem>
                    <MudItem md="4" sm="12">
                        <MudNumericField Class="mt-3"
                                         Label="Bike Spaces"
                                         Style="background-color: var(--mud-palette-surface);"
                                         @bind-Value="Model!.BikeSpaceCount"
                                         For="@(() => Model!.BikeSpaceCount)"
                                         Min="0"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.PedalBike" />
                    </MudItem>
                    <MudItem md="12">
                        <MudAutocomplete T="TrainManufacturer"
                                         Label="Train Manufacturer"
                                         Style="background-color: var(--mud-palette-surface);"
                                         @bind-Value="Model.TrainManufacturer"
                                         SearchFunc="@SearchTrainManufacturers"
                                         ToStringFunc="@(_ => _?.Name)"
                                         For="@(() => Model.TrainManufacturer)"
                                         ResetValueOnEmptyText="true"
                                         OpenOnFocus="true"
                                         Clearable="true"
                                         Variant="Variant.Outlined"/>
                    </MudItem>
                </MudGrid>

            
            </MudCardContent>
            <MudCardActions>
                <MudButton ButtonType="ButtonType.Submit"
                           Size="Size.Large"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="ml-3 mb-6">Save Changes</MudButton>

                <MudButton ButtonType="ButtonType.Button"
                           Size="Size.Large"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           @onclick="GoBack"
                           Class="ml-3 mb-6">Cancel</MudButton>

            </MudCardActions>
        </MudCard>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Train? Model { get; set; }

    private EditContext? editContext;
    private ValidationMessageStore? messageStore;

    private string TitleText { get; set; } = String.Empty;

    private bool IsNewItem { get; set; }

    private int OriginalTrainNumber { get; set; } = 0;
    private string OriginalTrainName { get; set; } = String.Empty;

    protected override async Task OnInitializedAsync()
    {
        IsNewItem = Id == 0;

        if (IsNewItem)
        {
            TitleText = "Adding New Train";
            Model = new()
                {
                    SeatCount = 1,
                    TrainNumber = 1
                };
        } else
        {
            TitleText = "Editing Train Number " + Id;
            Model = await TrainService.FetchByIdAsync(Id);

            OriginalTrainNumber = Model!.TrainNumber;
            OriginalTrainName = Model!.Name;
        }

        if (Model != null)
        {
            editContext = new EditContext(Model);
            messageStore = new ValidationMessageStore(editContext);
        }
    }

    private void SeatCountChange(int seatCount)
    {
        if (Model != null)
        {
            Model.SeatCount = seatCount;
            Model.DisabledSeatCount = Model.DisabledSeatCount > Model.SeatCount ? Model.SeatCount : Model.DisabledSeatCount;
        }
    }

    private async Task<IEnumerable<TrainManufacturer>> SearchTrainManufacturers(string search, CancellationToken token)
    {
        return await TrainManufacturerService.FetchTrainManufacturerItemsAsync(search ?? string.Empty);
    }

    private async Task ValidSubmit()
    {
        if (Model != null)
        {
            if (IsNewItem)
            {
                Model.TrainManufacturerID = Model.TrainManufacturer.ID;
                Model.TrainManufacturer = null!;
                await TrainService.RegisterAsync(Model!);
            }
            else
            {
                await TrainService.UpdateInfoAsync(Model!);
            }

            GoBack();
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("admin/trains");
    }

    private async Task TrainNumberChanged(int trainNumber)
    {
        if (Model != null && editContext != null && messageStore != null)
        {
            var fieldIdentifier = editContext.Field(nameof(Model.TrainNumber));
            messageStore.Clear(fieldIdentifier);

            if (IsNewItem || trainNumber != OriginalTrainNumber)
            {
                bool IsTrainNumberUnique = await TrainService.IsTrainNumberUniqueAsync(trainNumber, OriginalTrainNumber);

                if (!IsTrainNumberUnique)
                {
                    messageStore.Add(fieldIdentifier, $"The train number {trainNumber} is not unique.");
                } else
                {
                    Model.TrainNumber = trainNumber;
                }
            }

            editContext.NotifyValidationStateChanged();
        }
    }
    private async Task TrainNameChanged(string trainName)
    {
        if (Model != null && editContext != null && messageStore != null)
        {
            var fieldIdentifier = editContext.Field(nameof(Model.Name));
            messageStore.Clear(fieldIdentifier);

            if (IsNewItem || trainName != OriginalTrainName)
            {
                bool IsTrainNameUnique = await TrainService.IsNameUniqueAsync(trainName, OriginalTrainName);

                if (!IsTrainNameUnique)
                {
                    messageStore.Add(fieldIdentifier, $"The name {trainName} is not unique.");
                } else
                {
                    Model.Name = trainName;
                }
            }

            editContext.NotifyValidationStateChanged();
        }
    }
}
