<MudPaper Class="pt-5 pb-3 pl-5 pr-2 my-6" style="width: 350px" Outlined="true">
    <MudGrid Class="pt-5 pl-3 pr-2" style="">
    @for (int i = 0; i < Total; i++)
        {
            bool filled = i < Reserved + Chosen;
            bool notAvailable = i < Reserved;

            int value = notAvailable ? 0 : i - Reserved + 1;

            <MudItem md="1" xs="1" Class="px-1 py-0">
                <MudIconButton
                         OnClick="@(() => HandleChosenChange(value))"
                         Icon="@(filled ? Icons.Material.Filled.Circle : Icons.Material.Outlined.Circle)"
                         Size="Size.Small"
                         Color="@(notAvailable ? Color.Default : Color.Success)" />
            </MudItem>
        }
    </MudGrid>
</MudPaper>



@code {
    [Parameter]
    public EventCallback<int> OnDotClick { get; set; }

    [Parameter]
    public int Total { get; set; }

    [Parameter]
    public int Reserved { get; set; }

    [Parameter]
    public int Chosen { get; set; }

    private async Task HandleChosenChange(int value)
    {
        if (value > 0 && value != Chosen)
        {
            await OnDotClick.InvokeAsync(value);
        }
    }
}
