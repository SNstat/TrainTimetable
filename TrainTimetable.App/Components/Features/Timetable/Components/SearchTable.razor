@using TrainTimetable.Business.Models
@using TrainTimetable.Business.Services

@inject ITimetableService timetableService

@if (SearchModel != null && TimetableItems != null)
{
    @if (TimetableItems.Count() == 0)
    {
        <MudText Class="mt-6" Align="Align.Center">There are no schedules for the desired destination.</MudText>
    } else
    {
        <MudText Class="mb-5" Typo="Typo.h6">Timetable of route: <span class="RouteLabel">@GetRoute()</span></MudText>
        <MudTable FixedHeader="true" Items="@TimetableItems" Hover="true" Breakpoint="Breakpoint.Sm">
            <ColGroup>
                @for (int i = 1; i <= 9; i++)
                {
                    if (i == 5 || i == 6)
                        { <col style="width: 15%"> }
                    else
                        { <col style="width: 10%">}
                }
            </ColGroup>
            <HeaderContent>
                <MudTh>Train Number</MudTh>
                <MudTh>Departure</MudTh>
                <MudTh>Arrival</MudTh>
                <MudTh>Duration</MudTh>
                <MudTh>From</MudTh>
                <MudTh>To</MudTh>
                <MudTh>Price</MudTh>
                <MudTh>Seats</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Train Number">@context.Train?.TrainNumber</MudTd>
                <MudTd Style="font-weight: bold;" DataLabel="Departure Time">@context.DepartureTime?.ToString(@"hh\:mm")</MudTd>
                <MudTd Style="font-weight: bold;" DataLabel="Arrival Time">@context.ArrivalTime?.ToString(@"hh\:mm")</MudTd>
                <MudTd DataLabel="Duration">@context.TripDuration</MudTd>
                <MudTd DataLabel="Departure Station">@context.DepartureStation?.Name</MudTd>
                <MudTd DataLabel="Arrival Station">@context.ArrivalStation?.Name</MudTd>
                <MudTd Style="font-weight: bold;" DataLabel="Price">@context.Price.ToDoubleDigit() €</MudTd>
                <MudTd DataLabel="Seats"><MudText Color="Color.Success">0 / @context.Train?.SeatCount</MudText></MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => ShowBtnPress(context.ID))">@((context.ShowDetails == true) ? "Hide" : "Show")</MudButton>
                </MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (context.ShowDetails)
                {
                    <MudTr>
                        <td colspan="9">
                            <MudCard>
                                <MudCardHeader>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.body1">Train schedule details: <strong>@context.Train?.TrainNumber</strong></MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                            </MudCard>
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
        </MudTable>
    }
}

@code {
    [Parameter]
    public TimetableSearchModel? SearchModel { get; set; } = null;

    private IEnumerable<TimetableItem>? TimetableItems;

    protected override async Task OnParametersSetAsync()
    {
        if (SearchModel != null)
        {
            int depId = SearchModel.DepartureStation.Key;
            int arrId = SearchModel.ArrivalStation.Key;

            DateOnly date = DateOnly.FromDateTime(SearchModel.SearchDate ?? DateTime.Today);

            TimetableItems = await timetableService.FetchLineItemsAsync(depId, arrId, date);
        }
    }

    private void ShowBtnPress(int id)
    {
        var timetableItem = TimetableItems?.FirstOrDefault(_ => _.ID == id);

        if (timetableItem != null)
        {
            timetableItem.ShowDetails = !timetableItem.ShowDetails;
        }
    }

    private string GetRoute()
    {
        TimetableItem? item = TimetableItems?.First();
        
        ArgumentNullException.ThrowIfNull(item);

        return item.DepartureStation?.Name + " -> " + item.ArrivalStation?.Name;
    }
}