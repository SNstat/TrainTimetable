@using TrainTimetable.App.Components.Features.Timetable.Components
@using TrainTimetable.Business.Models

@page "/timetable"

<PageTitle>Timetable</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <div id="SearchBar" class="SearchItemContainer @( _colapsedSearchBar ? "Collapsed" : "Expanded")"
         @onclick="ToggleSearchBar">
        <MudPaper Elevation="3" Class="px-8 py-8 mx-10 my-12">
            <SearchBar OnSearch="HandleSearch" IsCollapsed="@_colapsedSearchBar"/>
        </MudPaper>
    </div>
    
    <div id="SearchTable" class="SearchItemContainer @( _colapsedSearchBar ? "Expanded" : "Collapsed")">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            @if (TimetableSearchModel != null)
            {
                <div class="TableContainer">
                    <SearchTable SearchModel="TimetableSearchModel"/>
                </div>
            }
        </MudContainer>
    </div>
</MudContainer>

@code {
    private TimetableSearchModel? TimetableSearchModel { get; set; } = null;

    private bool _colapsedSearchBar { get; set; }

    private void HandleSearch(TimetableSearchModel timetableSearchModel)
    {
        _colapsedSearchBar = timetableSearchModel == null ? false : true;
        TimetableSearchModel = timetableSearchModel;
    }

    private void ToggleSearchBar()
    {
        _colapsedSearchBar = !_colapsedSearchBar;
    }
}