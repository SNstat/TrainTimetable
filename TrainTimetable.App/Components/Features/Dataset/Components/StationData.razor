@page "/dataset/stations"

@attribute [Authorize(Roles = "Admin")]
@layout DatasetLayout

@inject IStationService StationService

<PageTitle>Station Data</PageTitle>

<MudText Typo="Typo.h6">Stations</MudText>

@if (Stations.Any())
{
    <MudDataGrid Items="@Stations"
                 Class="mt-6"
                 Hover
                 FixedHeader
                 Height="calc(100vh - 285px)"
                 style="background-color: var(--mud-palette-drawer-background);">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Location Name" InitialDirection="SortDirection.Ascending" />
            <PropertyColumn Property="x => x.Country.Name" Title="Country"/>
            <PropertyColumn Property="x => x.IsNode" Title="Crossing/Node"/>
        </Columns>
    </MudDataGrid>
} else
{
    <DataLoading/>
}

@code {
    private IEnumerable<Station> Stations = [];

    protected override async Task OnInitializedAsync()
    {
        //await Task.Delay(1000);
        Stations = await StationService.FetchAllAsync();

    }
}

