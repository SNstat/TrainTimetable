@page "/not-found"

@inject NavigationManager navigationManager

<PageTitle>Not Found</PageTitle>

<MudStack Class="px-8 py-8">
    <MudText Typo="Typo.h4">Not Found</MudText>
    <MudText>Sorry, the content you are looking for does not exist.</MudText>
    <MudButton Style="max-width: 200px;" Color="Color.Primary" @onclick="GoHome" Variant="Variant.Filled">Go to Home</MudButton>
</MudStack>

@code {
    private void GoHome()
    {
        navigationManager.NavigateTo("/");
    }
}