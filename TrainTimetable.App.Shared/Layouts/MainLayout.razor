@using TrainTimetable.App.Shared.Layouts.Themes

@inherits LayoutComponentBase

@inject NavigationManager NavigationManager

<MudThemeProvider Theme="_CustomMudTheme"/>
<MudPopoverProvider/>

<MudLayout>
    <div class="appbar">
        <MudAppBar Elevation="1">

            <MudAvatar Color="Color.Primary" Class="mr-5">
                <!--<MudImage Src="Assets/Images/TTTlogo.png" Alt="TTT Logo" Height="64" Width="64"></MudImage>-->
                <MudIcon Icon="@Icons.Material.Filled.Train"></MudIcon>
            </MudAvatar>

            <MudText><b>T</b>rains<b>T</b>ime<b>T</b>able</MudText>

            <MudSpacer />

            <Navbar/>

            <MudSpacer />

            <AuthorizeView>
                <Authorized>
                    <MudMenu FullWidth="true" AnchorOrigin="Origin.BottomLeft">
                        <ActivatorContent Context="menuContext">
                            <div @onclick="@menuContext.ToggleAsync" style="cursor: pointer">
                                <MudAvatar Color="Color.Secondary">
                                    @context.User?.Identity?.Name?[0].ToString().ToUpper()
                                </MudAvatar>
                            </div>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="@(() => NavigationManager.NavigateTo("/Account/Manage", true))">
                                <MudStack Row="true">
                                    <MudIcon Icon="@Icons.Material.Outlined.Edit"></MudIcon>
                                    Manage Profile
                                </MudStack>
                            </MudMenuItem>
                            <MudMenuItem OnClick="@(() => NavigationManager.NavigateTo("/Account/Logout", true))">
                                <MudStack Row="true">
                                    <MudIcon Icon="@Icons.Material.Outlined.Logout"></MudIcon>
                                    Sign Out
                                </MudStack>
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </Authorized>
                <NotAuthorized>
                    <MudButton OnClick="@(() => NavigationManager.NavigateTo("/Account/Login"))"
                               Color="Color.Primary"
                               Variant="Variant.Filled">
                        Login
                    </MudButton>
                </NotAuthorized>
            </AuthorizeView>

            <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" OnClick="@((e) => DrawerToggle())" />
        </MudAppBar>
    </div>
    <MudDrawer Anchor="Anchor.End" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private CustomMudTheme _CustomMudTheme = new CustomMudTheme();

    bool _drawerOpen = false;

    private bool IsAccountRoute => NavigationManager.Uri.Contains("/Account");

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}