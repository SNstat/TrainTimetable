@using TrainTimetable.App.Shared.Layouts.Themes

@inherits LayoutComponentBase

@inject NavigationManager NavigationManager

<MudThemeProvider Theme="_CustomMudTheme" />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudStack Row="true">
            <MudText Typo="Typo.h5" Class="ml-3" @onclick="@(() => NavigationManager.NavigateTo("/", true))" Style="cursor: pointer;">Train Timetable</MudText>
            <MudIcon Icon="@Icons.Material.Filled.Train" Class="mt-1"></MudIcon>
        </MudStack>
        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <MudMenu FullWidth="true" AnchorOrigin="Origin.BottomLeft">
                    <ActivatorContent Context="menuContext">
                        <div @onclick="@menuContext.ToggleAsync" style="cursor: pointer">
                            <MudAvatar Color="Color.Primary">
                                @context.User?.Identity?.Name?[0].ToString().ToUpper()
                            </MudAvatar>
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="@(() => NavigationManager.NavigateTo("/Account/Manage", true))">
                            <MudStack Row="true">
                                <MudIcon Icon="@Icons.Material.Outlined.Edit"></MudIcon>
                                Manage Profile
                            </MudStack>
                        </MudMenuItem>
                        <MudMenuItem OnClick="@(() => NavigationManager.NavigateTo("/Account/Logout", true))">
                            <MudStack Row="true">
                                <MudIcon Icon="@Icons.Material.Outlined.Logout"></MudIcon>
                                Sign Out
                            </MudStack>
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton OnClick="@(() => NavigationManager.NavigateTo("/Account/Login"))"
                         Color="Color.Primary"
                         Variant="Variant.Filled">
                    Login
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>

        <MudIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <Navbar/>
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private CustomMudTheme _CustomMudTheme = new CustomMudTheme();

    bool _drawerOpen = false;

    private bool IsAccountRoute => NavigationManager.Uri.Contains("/Account");

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}