@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Forgot password confirmation</PageTitle>

<MudStack Class="px-8 mt-8" Row="true">
    <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.Email" Size="Size.Large" Class="mt-1"></MudIcon>
    <MudStack>
        <MudText Typo="Typo.h4" Color="Color.Primary">Forgot password confirmation</MudText>
        <MudText>Please check your email to reset your password.</MudText>
    </MudStack>
</MudStack>
