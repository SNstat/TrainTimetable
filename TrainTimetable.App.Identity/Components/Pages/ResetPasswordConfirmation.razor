@page "/Account/ResetPasswordConfirmation"

<PageTitle>Reset password confirmation</PageTitle>

<MudStack Class="px-8" Row="true">
    <MudIcon Color="Color.Success" Icon="@Icons.Material.Filled.Check" Size="Size.Large" Class="mt-1"></MudIcon>
    <MudStack>
        <MudText Typo="Typo.h4" Color="Color.Success">Reset password confirmation</MudText>
        <MudText>Your password has been reset. Please <a href="Account/Login">click here to log in</a>.</MudText>
    </MudStack>
</MudStack>
