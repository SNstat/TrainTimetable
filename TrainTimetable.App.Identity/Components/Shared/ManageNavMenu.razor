@using Microsoft.AspNetCore.Components.Routing

@inject SignInManager<ApplicationUser> SignInManager

<MudNavMenu Class="mud-width-full">
    <MudStack Spacing="1">
        <MudNavLink Href="Account/Manage" Match="NavLinkMatch.All">Profile</MudNavLink>
        <MudNavLink Href="Account/Manage/Email" Match="NavLinkMatch.Prefix">Email</MudNavLink>
        <MudNavLink Href="Account/Manage/ChangePassword" Match="NavLinkMatch.Prefix">Password</MudNavLink>
            
        @if (hasExternalLogins)
        {
            <MudNavLink Href="Account/Manage/ExternalLogins" Match="NavLinkMatch.Prefix">External logins</MudNavLink>
        }
            
        <MudNavLink Href="Account/Manage/TwoFactorAuthentication" Match="NavLinkMatch.Prefix">Two-factor authentication</MudNavLink>
@*         <MudNavLink Href="Account/Manage/Passkeys" Match="NavLinkMatch.Prefix">Passkeys</MudNavLink>
 *@        <MudNavLink Href="Account/Manage/PersonalData" Match="NavLinkMatch.Prefix">Personal data</MudNavLink>
    </MudStack>
</MudNavMenu>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
